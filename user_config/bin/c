#!/usr/bin/env bash
set -euo pipefail

model="gpt-5.6-sol"

# A leading model selector is optional; running `c` without one defaults to Sol.
case "${1:-}" in
  luna)
    model="gpt-5.6-luna"
    shift
    ;;
  terra)
    model="gpt-5.6-terra"
    shift
    ;;
  sol)
    shift
    ;;
esac

project_roots=(
  "/home/daniel/Projects/studies"
  "/home/daniel/Projects/notes"
)
current_dir="$(realpath "$PWD")"
project_root=""
relative_dir=""

for root in "${project_roots[@]}"; do
  case "$current_dir" in
    "$root")
      project_root="$root"
      relative_dir="."
      break
      ;;
    "$root"/*)
      project_root="$root"
      relative_dir="${current_dir#"$root"/}"
      break
      ;;
  esac
done

if [[ -z "$project_root" ]]; then
  printf 'c: current directory is not inside a supported project root:\n' >&2
  printf '  %s\n' "${project_roots[@]}" >&2
  exit 1
fi

cd "$project_root"
exec /home/daniel/.npm-global/bin/codex --model "$model" --cd "$relative_dir" "$@"
