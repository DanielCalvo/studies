#!/usr/bin/env bash
set -euo pipefail

file_path="${1:?Usage: c-markdown FILE}"
file_path="$(realpath "$file_path")"

exec xfce4-terminal \
  --title="Codex: $(basename "$file_path")" \
  --execute bash -lc '
    file_path="$1"
    cd "$(dirname "$file_path")"

    /home/daniel/bin/c \
      "Run the fix markdown skill on $file_path -- the skill definition is located at /home/daniel/Projects/studies/.codex/skills/fix-markdown/SKILL.md"

    exec bash
  ' bash "$file_path"
